#!/bin/bash
#
# Build, verify and flash Flinduino sketches with the native arm64 toolchain.
#
#   flinduino doctor                  check the install and write platform.local.txt
#   flinduino build  <sketch-dir>
#   flinduino check  <sketch-dir>     verify flash layout without flashing
#   flinduino flash  <sketch-dir> [port]
#   flinduino run    <sketch-dir> [port]     build + check + flash
#   flinduino monitor [port]
#
# Everything is resolved relative to this script, so the package can live
# anywhere. Uploads go through pic32prog, which is a host binary and needs the
# serial port, so it is never containerised.
set -euo pipefail

PKG="$(cd "$(dirname "$0")/.." && pwd)"
TOOLCHAIN="$PKG/toolchain/mipsel-pic32-elf"
FQBN="flinduino:pic32:Flinduino"
BAUD=115200

# The bootloader image, entry point and image pointer table this board expects.
# check() refuses to flash anything that disagrees.
WANT_ENTRY=0x9d001000
WANT_IMGPTR=9d0000f8

PIC32PROG="${PIC32PROG:-$HOME/Library/Arduino15/packages/Flinders/tools/pic32prog/v2.1.46/pic32prog}"
OBJDUMP="$TOOLCHAIN/bin/mipsel-pic32-elf-objdump"

die() { echo "error: $*" >&2; exit 1; }

# arduino-cli needs to see our platform. Rather than installing into the user's
# sketchbook, point it at the package with a throwaway config, so nothing
# outside this directory is touched.
cli_config() {
    # arduino-cli discovers platforms at <user>/hardware/<packager>/<arch>, and
    # the link has to be at the packager level - linking the arch directory
    # alone is not followed. The platform lives at pic32/ in this repo (matching
    # the chipKIT-core layout), so the repo root stands in as the packager
    # directory. Kept outside the repo: a link pointing at $PKG from inside $PKG
    # would make the tree recursive, and it keeps the working copy clean.
    local root="${TMPDIR:-/tmp}/flinduino-cli-$(echo "$PKG" | shasum | cut -c1-12)"
    mkdir -p "$root/hardware"
    ln -sfn "$PKG" "$root/hardware/flinduino"
    local cfg="$root/arduino-cli.yaml"
    cat > "$cfg" <<EOF
directories:
  data: $HOME/Library/Arduino15
  user: $root
EOF
    echo "$cfg"
}

arduino_cli() {
    command -v arduino-cli >/dev/null || die "arduino-cli not found (brew install arduino-cli)"
    arduino-cli --config-file "$(cli_config)" "$@"
}

# Find the Flinduino, not some other usbmodem. The board reports itself in
# ioreg, so check that before trusting any port name.
find_port() {
    ioreg -p IOUSB -w0 -l 2>/dev/null | grep -q Flinduino || { echo ""; return; }
    local p
    for p in /dev/cu.usbmodem*; do
        [ -e "$p" ] || continue
        echo "$p"; return
    done
    echo ""
}

sketch_dir() { [ -n "${1:-}" ] || die "need a sketch directory"; (cd "$1" && pwd); }
sketch_elf() { echo "$1/build/$(basename "$1").ino.elf"; }
sketch_hex() { echo "$1/build/$(basename "$1").ino.hex"; }

cmd_doctor() {
    local ok=0
    echo "package:    $PKG"
    if [ -x "$TOOLCHAIN/bin/mipsel-pic32-elf-gcc" ]; then
        echo "toolchain:  $("$TOOLCHAIN/bin/mipsel-pic32-elf-gcc" --version | head -1)"
    else
        echo "toolchain:  MISSING - run tools/setup-toolchain.sh"; ok=1
    fi
    command -v arduino-cli >/dev/null \
        && echo "arduino-cli: $(arduino-cli version 2>/dev/null | head -1)" \
        || { echo "arduino-cli: MISSING - brew install arduino-cli"; ok=1; }
    [ -x "$PIC32PROG" ] \
        && echo "pic32prog:  $PIC32PROG" \
        || { echo "pic32prog:  MISSING - install the Flinders board package once, or set PIC32PROG"; ok=1; }

    # platform.local.txt carries the one machine-specific value: where the
    # toolchain lives. Regenerating it is what makes the package relocatable.
    local local_txt="$PKG/pic32/platform.local.txt"
    cat > "$local_txt" <<EOF
# Generated by 'flinduino doctor'. Machine-specific paths only.
# platform.txt is written against these two properties so the package can be
# moved or shared without editing recipes.
pic32.root=$TOOLCHAIN
pic32.pic32prog=$(dirname "$PIC32PROG")
EOF
    echo "wrote:      pic32/platform.local.txt"

    local port; port="$(find_port)"
    [ -n "$port" ] && echo "board:      $port" || echo "board:      not connected"
    return $ok
}

cmd_build() {
    local s; s="$(sketch_dir "${1:-}")"
    echo "==> building $(basename "$s")"
    # --clean rather than deleting ~/Library/Caches/arduino by hand; a stale
    # sketch cache makes arduino-cli spin forever on a changed platform.
    arduino_cli compile --clean -b "$FQBN" --output-dir "$s/build" "$s"
}

# The bootloader lives in boot flash and owns DEVCFG. Refuse to flash anything
# that would land there - recovering needs a PICkit.
cmd_check() {
    local s; s="$(sketch_dir "${1:-}")"
    local elf; elf="$(sketch_elf "$s")"
    [ -f "$elf" ] || die "no elf at $elf - build first"

    local entry ptr
    entry=$("$OBJDUMP" -f "$elf" | awk '/start address/{print $3}')
    ptr=$("$OBJDUMP" -h "$elf" | awk '$2==".image_ptr_table"{print $4}')
    echo "==> flash layout"
    echo "    entry            $entry   (expected $WANT_ENTRY)"
    echo "    .image_ptr_table 0x$ptr   (expected 0x$WANT_IMGPTR)"

    [ "$entry" = "$WANT_ENTRY" ] || die "entry $entry is not the bootloader app entry $WANT_ENTRY"
    [ "$ptr" = "$WANT_IMGPTR" ]  || die "image pointer table at 0x$ptr, expected 0x$WANT_IMGPTR"

    if "$OBJDUMP" -h "$elf" | awk '$4 ~ /^(9fc|bfc)/ && $3 !~ /^0+$/ {f=1} END{exit !f}'; then
        echo "    sections in boot flash / DEVCFG:" >&2
        "$OBJDUMP" -h "$elf" | awk '$4 ~ /^(9fc|bfc)/ && $3 !~ /^0+$/ {print "      "$2" @0x"$4" size 0x"$3}' >&2
        die "image would overwrite the bootloader"
    fi
    echo "    nothing in boot flash or DEVCFG - safe to flash"
}

cmd_flash() {
    local s; s="$(sketch_dir "${1:-}")"
    local port="${2:-$(find_port)}"
    [ -n "$port" ] || die "no Flinduino found - is it plugged in?"
    cmd_check "$s"

    # A running sketch holds the port; opening it at 1200 baud is the Arduino
    # convention for asking the CDC stack to reset into the bootloader. It only
    # works if the running sketch still has USB alive, so -R covers the case
    # where it does not and the user has to hold BOOT and tap RESET instead.
    # pic32prog retries about twice a second, so -R 600 waits roughly 5 minutes.
    echo "==> requesting bootloader on $port"
    stty -f "$port" 1200 2>/dev/null || true
    sleep 2
    echo "==> flashing (hold BOOT and tap RESET if this waits)"
    "$PIC32PROG" -R 600 -d "$port" -b "$BAUD" "$(sketch_hex "$s")"
}

cmd_monitor() {
    local port="${1:-$(find_port)}"
    [ -n "$port" ] || die "no Flinduino found"
    echo "==> $port at $BAUD, ctrl-a k to quit"
    arduino_cli monitor -p "$port" -c "baudrate=$BAUD"
}

case "${1:-}" in
    doctor)  shift; cmd_doctor "$@" ;;
    build)   shift; cmd_build "$@" ;;
    check)   shift; cmd_check "$@" ;;
    flash)   shift; cmd_flash "$@" ;;
    run)     shift; s="$(sketch_dir "${1:-}")"; cmd_build "$s"; cmd_flash "$s" "${2:-}" ;;
    monitor) shift; cmd_monitor "$@" ;;
    *)       sed -n '2,12p' "$0" | sed 's/^#//'; exit 1 ;;
esac
