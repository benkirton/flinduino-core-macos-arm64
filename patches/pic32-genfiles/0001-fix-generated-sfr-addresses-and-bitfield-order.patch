@@ -210,7 +210,13 @@ class Chip {
                 foreach ($regdata['bits'] as $layer) {
                     $header[] = "    struct {";
                     $bits = $this->collapse($layer);
-                    foreach ($bits as $bit) {
+                    /* collapse() walks 31->0 so that 'pos' ends up at each
+                       field's least-significant bit, which is what the POSITION
+                       and MASK macros need. But GCC allocates bitfields
+                       LSB-first on a little-endian target, so the struct must be
+                       emitted in the opposite order or every field lands at
+                       31-pos. Reverse here only; the macros above are unaffected. */
+                    foreach (array_reverse($bits) as $bit) {
                         if ($bit['name'] == 'UNUSED') {
                             $header[] = "        unsigned :" . $bit['size'] . ";";
                         } else {
